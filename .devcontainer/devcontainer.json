{
  "name": "prm-sc",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // --- Isolation ---
  // Only the workspace is mounted. No extra host directories.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/prm-sc,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/prm-sc",

  // Drop all Linux capabilities; re-add only what Node/Expo need
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_BIND_SERVICE",
    "--security-opt=no-new-privileges"
  ],

  // --- Environment ---
  // Secrets loaded from .env.local at runtime (gitignored)
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // --- Features ---
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // --- VS Code settings inside the container ---
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.preferences.importModuleSpecifier": "non-relative"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "anthropic.claude-code"
      ]
    }
  },

  // --- Ports ---
  "forwardPorts": [
    8081,
    19000,
    19001,
    19002
  ],
  "portsAttributes": {
    "8081": { "label": "Metro Bundler" },
    "19000": { "label": "Expo Dev Server" },
    "19001": { "label": "Expo Dev Tools" },
    "19002": { "label": "Expo Web" }
  },

  // --- Lifecycle ---
  "postCreateCommand": "pnpm install || true",
  "postStartCommand": "if [ -f .env.local ]; then set -a && . ./.env.local && set +a; fi",
  "remoteUser": "node"
}
